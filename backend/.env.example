# SurgeAI backend — copy to `.env` and fill in real values (never commit `.env`).
# Loaded from `backend/.env` via `backend/app/core/settings.py`.

# --- Required API keys & cloud ---
GEMINI_API_KEY=replace_me
# Default model in code: gemini-2.5-flash. Free tier: lower VLM_MAX_HZ, enable billing for higher caps.
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=replace_me
ELEVENLABS_API_KEY=replace_me

MONGODB_URI=replace_me
MONGODB_DB_NAME=surgeai

SNOWFLAKE_ACCOUNT=replace_me
SNOWFLAKE_USER=replace_me
SNOWFLAKE_PASSWORD=replace_me
SNOWFLAKE_WAREHOUSE=replace_me
SNOWFLAKE_DATABASE=replace_me
SNOWFLAKE_SCHEMA=replace_me
SNOWFLAKE_ROLE=replace_me

# --- Hardware & server ---
BRIO_CAMERA_INDEX=0
# Windows: auto (try DirectShow, then MSMF) | dshow | msmf | default — use dshow if MSMF can't grab frames
CAMERA_BACKEND=auto
BRIO_MIC_INDEX=0
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
SOCKET_NAMESPACE=/realtime
EVENT_SCHEMA_VERSION=1
ENV=development
# DEBUG | INFO | WARNING | ERROR — controls backend console + logging/logs/surgeai-backend.log
LOG_LEVEL=INFO
# Optional: override log directory (default: repo/logging/logs)
# SURGEAI_LOG_DIR=C:\path\to\logs

# --- Loop A / VLM tuning ---
CAPTURE_TARGET_FPS=20
# ~1 Gemini vision call / 5s at 0.2 — raise only if you need faster VLM (uses more quota).
VLM_MAX_HZ=0.2
VLM_JPEG_QUALITY=65
GUIDANCE_MIN_INTERVAL_SECONDS=10
# After Gemini errors, pause new vision calls (saves quota).
GEMINI_RATE_LIMIT_BACKOFF_SECONDS=120
GEMINI_ERROR_BACKOFF_SECONDS=30
LOOP_A_INTERVAL_SECONDS=0

# --- Loop B (voice Q&A) — set false for VLM-only testing ---
LOOP_B_ENABLED=true
